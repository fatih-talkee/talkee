# ============================================
# ENVIRONMENT VARIABLES TEMPLATE
# ============================================
# 
# Bu dosyayı kopyalayıp .env olarak kaydedin ve gerçek değerleri doldurun:
# cp .env.example .env
#
# ⚠️ ÖNEMLİ: .env dosyası git'e commit edilmemeli (.gitignore'da var)

# ============================================
# SUPABASE
# ============================================
# Supabase Dashboard → Settings → API
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ============================================
# STRIPE (Payment Processing)
# ============================================
# Stripe Dashboard → Developers → API keys
# Test Mode: https://dashboard.stripe.com/test/apikeys
# Production: https://dashboard.stripe.com/apikeys

# Publishable Key (Frontend - Public)
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Secret Key (Backend - Supabase Secrets'e eklenecek, buraya DEĞİL)
# STRIPE_SECRET_KEY=sk_test_... (Supabase Dashboard → Secrets)

# Webhook Secret (Supabase Secrets'e eklenecek, buraya DEĞİL)
# STRIPE_WEBHOOK_SECRET=whsec_... (Supabase Dashboard → Secrets)

# ============================================
# NOTLAR
# ============================================
# 
# 1. EXPO_PUBLIC_ prefix ZORUNLU (Expo için)
# 2. Secret keys asla frontend'e eklenmemeli
# 3. Supabase Secrets için: Dashboard → Project Settings → Secrets
# 4. Production keys için test keys'leri değiştir
