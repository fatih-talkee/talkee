{
  "name": "talkee",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "EXPO_NO_TELEMETRY=1 expo start --dev-client --clear",
    "dev": "EXPO_NO_TELEMETRY=1 expo start --dev-client --clear",
    "reset": "rimraf $TMPDIR/metro-* $TMPDIR/haste-map-* || true && watchman watch-del-all || true",
    "lint": "expo lint",
    "android": "expo run:android",
    "android:studio": "cd android && ./gradlew installDebug",
    "android:clean": "cd android && ./gradlew clean",
    "build:apk": "cd android && ./gradlew assembleRelease",
    "build:aab": "cd android && ./gradlew bundleRelease",
    "build:web": "expo export --platform web",
    "ios": "expo run:ios",
    "postinstall": "mkdir -p node_modules/missing-asset-registry-path && echo 'module.exports = {};' > node_modules/missing-asset-registry-path/index.js && echo '{\"name\": \"missing-asset-registry-path\", \"version\": \"1.0.0\", \"main\": \"index.js\"}' > node_modules/missing-asset-registry-path/package.json"
  },
  "dependencies": {
    "@expo-google-fonts/inter": "^0.4.1",
    "@expo/vector-icons": "^14.1.0",
    "@lucide/lab": "^0.1.2",
    "@miblanchard/react-native-slider": "^2.6.0",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/datetimepicker": "8.4.1",
    "@supabase/supabase-js": "^2.86.0",
    "@tanstack/react-query": "^5.90.11",
    "@twilio/voice-react-native-sdk": "^1.7.0",
    "expo": "^54.0.25",
    "expo-blur": "~14.1.3",
    "expo-build-properties": "~0.14.8",
    "expo-camera": "~16.1.5",
    "expo-constants": "~17.1.3",
    "expo-device": "~7.1.4",
    "expo-font": "~13.3.2",
    "expo-haptics": "~14.1.3",
    "expo-image-picker": "~16.1.4",
    "expo-linear-gradient": "~14.1.5",
    "expo-linking": "~7.1.3",
    "expo-localization": "~16.1.6",
    "expo-notifications": "~0.31.4",
    "expo-router": "^3.5.23",
    "expo-splash-screen": "~0.30.10",
    "expo-status-bar": "~2.2.2",
    "expo-symbols": "~0.4.3",
    "expo-system-ui": "~5.0.5",
    "expo-web-browser": "~14.2.0",
    "firebase": "^11.0.0",
    "i18next": "^23.15.2",
    "intl-pluralrules": "^2.0.1",
    "libphonenumber-js": "^1.12.31",
    "lucide-react-native": "^0.475.0",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-i18next": "^15.0.2",
    "react-native": "0.79.6",
    "react-native-calendars": "^1.1313.0",
    "react-native-gesture-handler": "~2.24.0",
    "react-native-mask-input": "^1.2.3",
    "react-native-qrcode-svg": "^6.3.16",
    "react-native-reanimated": "~3.17.4",
    "react-native-safe-area-context": "5.4.0",
    "react-native-screens": "~4.11.1",
    "react-native-svg": "15.11.2",
    "react-native-toast-message": "^2.3.3",
    "react-native-url-polyfill": "^2.0.0",
    "react-native-web": "^0.20.0",
    "react-native-webview": "13.13.5",
    "tsx": "^4.21.0",
    "yup": "^1.7.1",
    "zod": "^4.1.13"
