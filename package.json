    "dotenv": "^17.2.3",
    "expo-dev-client": "^6.0.16",
    "metro": "^0.82.0",
    "metro-config": "^0.82.0",
    "metro-core": "^0.82.0",
    "rimraf": "^5.0.7",
    "typescript": "~5.8.3"
  },
  "engines": {
    "node": ">=18"
  }
}
