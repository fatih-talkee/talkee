{
  "expo": {
    "name": "Talkee",
    "slug": "talkee",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "talkee",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/images/splash.png",
      "resizeMode": "cover",
      "backgroundColor": "#000000"
    },
    "newArchEnabled": false,
    "ios": {
      "bundleIdentifier": "net.talkee.app",
      "displayName": "Talkee",
      "supportsTablet": true,
      "googleServicesFile": "./firebase/ios/GoogleService-Info.plist",
      "infoPlist": {
        "CFBundleDisplayName": "Talkee",
        "CFBundleName": "Talkee",
        "NSMicrophoneUsageDescription": "This app needs microphone access for calls.",
        "NSCameraUsageDescription": "This app needs camera access for video calls and profile photos.",
        "NSPhotoLibraryUsageDescription": "This app needs photo library access to upload profile photos.",
        "NSPhotoLibraryAddUsageDescription": "This app needs permission to save photos to your library.",
        "NSFaceIDUsageDescription": "This app uses Face ID for secure authentication.",
        "UIBackgroundModes": ["audio", "voip"],
        "AVAudioSessionCategory": "PlayAndRecord"
      },
      "config": {
        "stripe": {
          "merchantIdentifier": "merchant.net.talkee.app"
        }
      }
    },
    "android": {
      "package": "net.talkee.app",
      "versionCode": 1,
      "versionName": "1.0.0",
      "googleServicesFile": "./firebase/android/google-services.json",
      "permissions": [
        "RECORD_AUDIO",
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "READ_MEDIA_IMAGES",
        "READ_MEDIA_VIDEO",
        "POST_NOTIFICATIONS",
        "MODIFY_AUDIO_SETTINGS",
        "BLUETOOTH",
        "BLUETOOTH_CONNECT",
        "WAKE_LOCK",
        "FOREGROUND_SERVICE"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#000000",
        "monochromeImage": "./assets/images/icon.png"
      },
      "splash": {
        "image": "./assets/images/splash.png",
        "resizeMode": "cover",
        "backgroundColor": "#000000"
      }
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser",
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static"
          },
          "android": {
            "usesCleartextTraffic": true,
            "minSdkVersion": 24,
            "targetSdkVersion": 35,
            "compileSdkVersion": 35
          }
        }
      ],
      "expo-localization",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#ffffff"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Talkee to access your photos to update your profile picture.",
          "cameraPermission": "Allow Talkee to use your camera to take profile pictures.",
          "mediaLibraryPermission": "Allow Talkee to access your media library to upload photos and videos."
        }
      ],
      "@react-native-community/datetimepicker",
      "@sentry/react-native",
      [
        "@stripe/stripe-react-native",
        {
          "merchantIdentifier": "merchant.net.talkee.app"
        }
      ]
    ],
    "web": {
      "favicon": "./assets/images/favicon.png",
      "bundler": "metro"
    },
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "firebase": {
        "apiKey": "AIzaSyDEfmC53rDYrwAJdL-HwB-sYJ4_h_HWnA0",
