<?xml version="1.0" encoding="utf-8"?>
<resources>
  <!--
    Twilio Voice RN SDK registers its own FirebaseMessagingService with MESSAGING_EVENT.
    That can prevent expo-notifications from receiving FCM messages (notably in foreground).

    We disable Twilio's service and handle Twilio call payloads in our own
    `net.talkee.app.TalkeeFirebaseMessagingService`.
  -->
  <bool name="twiliovoicereactnative_firebasemessagingservice_enabled">false</bool>
</resources>



